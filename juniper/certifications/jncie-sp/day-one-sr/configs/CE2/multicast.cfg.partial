ip multicast-routing
!
ip route 0.0.0.0 0.0.0.0 10.1.12.1
!
interface Ethernet0/1
 no shutdown
 ip address 10.1.12.12 255.255.255.0
 ipv6 address 2001:10:1:12::12/64
 ip pim sparse-mode
!
interface Ethernet0/2
 no shutdown
 ip address 10.2.12.12 255.255.255.0
 ipv6 address 2001:10:2:12::12/64
 ip pim sparse-mode
!
interface Loopback0
 no shutdown
 ip address 172.16.0.2 255.255.255.255
 ipv6 address 2001:db8:172:16::2/128
 ip pim sparse-mode
!
