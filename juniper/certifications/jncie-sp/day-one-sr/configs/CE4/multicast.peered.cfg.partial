ip multicast-routing
!
ip pim ssm default
!
ip route 0.0.0.0 0.0.0.0 10.8.14.8
!
interface Ethernet0/1
 no shutdown
 ip address 10.8.14.14 255.255.255.0
 ipv6 address 2001:10:8:14::14/64
 ip pim sparse-mode
!
interface Loopback0
 no shutdown
 ip address 172.16.0.4 255.255.255.255
 ipv6 address 2001:db8:172:16::4/128
 ip pim sparse-mode
!
router bgp 1004
 neighbor 10.8.14.8 remote-as 100
 network 172.16.0.4 mask 255.255.255.255
!

