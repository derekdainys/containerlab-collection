ip multicast-routing
!
ip route 0.0.0.0 0.0.0.0 10.2.13.2
!
interface Ethernet0/1
 no shutdown
 ip address 10.2.13.13 255.255.255.0
 ipv6 address 2001:10:2:13::13/64
 ip pim sparse-mode
!
interface Loopback0
 no shutdown
 ip address 172.16.0.3 255.255.255.255
 ipv6 address 2001:db8:172:16::3/128
 ip pim sparse-mode
!
