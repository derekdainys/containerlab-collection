ip multicast-routing
!
ip pim ssm default
!
ip route 0.0.0.0 0.0.0.0 10.9.16.9
!
interface Ethernet0/1
 no shutdown
 ip address 10.9.16.16 255.255.255.0
 ipv6 address 2001:10:9:16::16/64
 ip pim sparse-mode
!
interface Loopback0
 no shutdown
 ip address 172.16.0.6 255.255.255.255
 ipv6 address 2001:db8:172:16::6/128
 ip pim sparse-mode
!
router bgp 1006
 neighbor 10.9.16.9 remote-as 100
 network 172.16.0.6 mask 255.255.255.255
!